# Variables de connexion PostgreSQL
DB_NAME=site_marketing
DB_USER=marketteur
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# Alternative : URL complète de connexion (prioritaire sur les variables ci-dessus)
# Render la fournit automatiquement en production.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Django
SECRET_KEY=change_me
DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Cloudinary (stockage des images uploadées)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# ou séparément :
# CLOUDINARY_CLOUD_NAME=cloud_name
# CLOUDINARY_API_KEY=api_key
# CLOUDINARY_API_SECRET=api_secret

# Render (renseigné automatiquement par la plateforme)
# RENDER_EXTERNAL_HOSTNAME=mon-site.onrender.com

# Sécurité (à activer en production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False